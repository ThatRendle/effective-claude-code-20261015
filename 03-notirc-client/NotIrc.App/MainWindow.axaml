<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NotIrc.App.ViewModels"
        xmlns:app="using:NotIrc.App"
        x:Class="NotIrc.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NotIrc" Width="900" Height="600" MinWidth="480" MinHeight="320">
  <Window.Resources>
    <!-- A translucent accent tint keeps the theme text colour readable in both light and dark themes. -->
    <SolidColorBrush x:Key="OwnEntryBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.own">
      <Setter Property="Background" Value="{DynamicResource OwnEntryBrush}" />
    </Style>
    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="Green" /></Style>
    <Style Selector="TextBlock.busy"><Setter Property="Foreground" Value="DarkOrange" /></Style>
    <Style Selector="TextBlock.bad"><Setter Property="Foreground" Value="Firebrick" /></Style>
    <Style Selector="ListBox.stale"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="TextBlock.dim"><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="Border.notice TextBlock"><Setter Property="FontStyle" Value="Italic" /><Setter Property="Opacity" Value="0.7" /></Style>
  </Window.Styles>

  <DockPanel>
    <!-- Status bar -->
    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Name="StatusLabel" FontWeight="SemiBold"
                   Text="{Binding StatusText}" Classes.ok="{Binding IsStatusOk}" Classes.busy="{Binding IsStatusBusy}" Classes.bad="{Binding IsStatusBad}" />
        <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" Classes="dim" Text="{Binding ServerAddress}" />
        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Choose nickname…"
                Command="{Binding ChooseNicknameCommand}" IsVisible="{Binding ShowChooseNickname}" />
        <TextBlock DockPanel.Dock="Right" Name="NicknameLabel" FontWeight="SemiBold" Text="{Binding Nickname}" />
      </DockPanel>
    </Border>

    <!-- Token-rejected / permanent error banner -->
    <Border DockPanel.Dock="Top" Name="ErrorBanner" Padding="12,8" Background="Firebrick"
            IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Foreground="White" TextWrapping="Wrap" Text="{Binding ErrorText}" />
    </Border>

    <!-- Input row -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12" ColumnSpacing="8">
      <TextBox Grid.Column="0" Name="InputBox" PlaceholderText="Type a message…" AcceptsReturn="False"
               Text="{Binding InputText}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Name="EmojiButton" Content="😀" ToolTip.Tip="Insert emoji">
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight">
            <ScrollViewer MaxHeight="320" Width="340">
              <ItemsControl ItemsSource="{x:Static app:EmojiCatalogue.Categories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:EmojiCategory">
                    <StackPanel Margin="0,0,0,8" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Classes="dim" />
                      <ItemsControl ItemsSource="{Binding Emoji}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}" Padding="6,4" Background="Transparent" Click="OnEmojiClick" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Flyout>
        </Button.Flyout>
      </Button>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
        <TextBlock Name="ByteCounter" HorizontalAlignment="Right" Classes="dim" Text="{Binding ByteCounterText}" />
        <TextBlock Name="TooLongWarning" HorizontalAlignment="Right" Foreground="Firebrick" FontWeight="SemiBold"
                   Text="Too long" IsVisible="{Binding IsOverLimit}" />
      </StackPanel>
      <Button Grid.Column="3" Name="SendButton" Content="Send" IsDefault="False"
              Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" />
    </Grid>

    <!-- Presence -->
    <Border DockPanel.Dock="Right" Width="180" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="12,8" FontWeight="SemiBold" Text="Online" />
        <ListBox Name="PresenceList" ItemsSource="{Binding Presence}" Classes.stale="{Binding IsPresenceStale}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Message log -->
    <ScrollViewer Name="LogScroll">
      <ItemsControl Name="LogList" ItemsSource="{Binding Entries}" Margin="12,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EntryViewModel">
            <Border Classes.own="{Binding IsOwn}" Classes.notice="{Binding IsNotice}" Padding="4,2" CornerRadius="4">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Time}" />
                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Nick}" IsVisible="{Binding IsChat}" />
                <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Text}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
